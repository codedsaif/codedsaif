# --- Contact form ---------------------------------------------------------
# Base URL of the micro.service backend that exposes POST /api/v1/contacts.
# The contact form's Server Action calls this server-side (never exposed to the
# browser). Defaults to http://localhost:8080 if unset.
CONTACT_API_URL=http://localhost:8080

# Google reCAPTCHA v3 SITE key (public). The backend requires a recaptchaToken,
# so this must match the SECRET key configured in the micro.service backend.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key
